Thumbs.db

# Miscellaneous
*.log
*.lock

/lib/generated/prisma
/lib/generated/careers

.venv/
venv/
__pycache__/
*.pyc

# ML Training Data (generated from database)
ml/data/*_train.json
ml/data/*_val.json
ml/data/*_test.json
# Generated datasets (GBs) — regenerate with `npm run sim:run` / `npm run ml:harvest`; manifests are kept
ml/data/**/*.jsonl
# Smoke/scratch datasets and checkpoints from local training experiments (never ship)
ml/data/**/*-smoke*/
ml/checkpoints/*-smoke*/
ml/checkpoints/smoke-*/

# ML model checkpoints ARE tracked (a few MB per version): the App Runner image bakes
# ml/checkpoints/ in, so what is in git is exactly what serves. Regenerate with
# `python -m haemologix.train` (see ml/README.md); promote with ml:approve / ml:activate.
# Retired imitation-model code (kept locally for reference; the originals live in git history)
ml/legacy/
ml/.venv/
.ml-api.log
.ml-api.err.log
.next-dev-*.log
.pytest_cache/

# ML Environment files
ml/.env.ml
ml/.env.ml.local

# Python cache in ML directory
ml/**/__pycache__/
ml/**/*.pyc
ml/**/*.pyo
ml/**/*.pyd

# ML Training logs and outputs
ml/logs/
ml/runs/
ml/*.log

# Jupyter Notebook checkpoints
ml/.ipynb_checkpoints/

# ML model exports
ml/models/exported/
ml/models/*.onnx
ml/models/*.tflite
# clerk configuration (can include secrets)
/.clerk/
*.tsbuildinfo

# Local deploy runbook with real secret values — never commit
ml/DEPLOY_RUNBOOK.local.md
*.local.md

# Vercel CLI project link
.vercel

.agents/
.claude/
.codex/
