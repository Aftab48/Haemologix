generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The single source of truth for a donor.
///
/// Created by `/donor/onboard` from a deliberately short form, then enriched over
/// time: the optional `profile` holds everything asked for later, page by page.
/// Every donor-related record hangs off this row.
model Donor {
  id                   String         @id @default(uuid())
  name                 String
  phone                String
  email                String         @unique
  address              String
  city                 String
  state                String
  pincode              String
  dateOfBirth          DateTime
  weight               String
  height               String
  bmi                  String
  hasDonatedBefore     Boolean        @default(false)
  lastDonationDate     DateTime?
  diseases             String?
  clerkUserId          String?
  /// Hashed (never plaintext) copy of the credential emailed at onboarding.
  /// Optional because donors created before this column existed have none.
  password             String?
  status               ApprovalStatus @default(PENDING)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  bloodGroup           String
  gender               String
  isAvailable          Boolean        @default(true)
  /// Geocoded from the address at onboarding, or replaced by a device GPS fix
  /// from the mobile app. The matching agent discards donors outside an alert's
  /// search radius, so a donor without these can never be matched.
  latitude             String?
  longitude            String?
  /// Verification state. Lives here rather than on a form record because it
  /// describes the donor, and outlives any single submission.
  verificationAttempts Int            @default(0)
  suspendedUntil       DateTime?
  lastVerificationAt   DateTime?

  profile         DonorProfile?
  responses       AlertResponse[]
  responseHistory DonorResponseHistory[] @relation("DonorHistory")
  verifications   DonorVerification[]
  approvals       Approval[]             @relation("DonorApprovals")

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([status, bloodGroup])
}

/// Detail collected after onboarding, a section at a time.
///
/// Every column is nullable by design — a donor may have answered none, some, or
/// all of it. Code reading these must treat absence as "not yet screened", never
/// as a pass: see `isDonorEligible` in lib/agents/donorAgent.ts.
model DonorProfile {
  id      String @id @default(uuid())
  donorId String @unique

  emergencyContact   String?
  emergencyPhone     String?
  medications        String?
  recentVaccinations Boolean?
  vaccinationDetails String?
  donationCount      String?

  /// Serology. "NEGATIVE" (in any case) is the only value that clears the gate;
  /// null means not yet tested, which is not the same as negative.
  hivTest        String?
  hepatitisBTest String?
  hepatitisCTest String?
  syphilisTest   String?
  malariaTest    String?

  hemoglobin    String?
  plateletCount String?
  wbcCount      String?

  /// Kept as columns rather than a separate documents table so `uploadDonorFile`
  /// can go on writing them by dynamic field name.
  bloodTestReport    String?
  idProof            String?
  medicalCertificate String?

  dataProcessingConsent   Boolean @default(false)
  medicalScreeningConsent Boolean @default(false)
  termsAccepted           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donor Donor @relation(fields: [donorId], references: [id], onDelete: Cascade)
}

// `DonorRegistration` was the original donor model — one long form, most of it
// optional in practice. It was replaced by `Donor` + `DonorProfile` above, which
// separate the short onboarding record from the detail gathered later.

model OTSchedule {
  id            String               @id @default(cuid())
  hospitalId    String
  patientName   String
  surgeryType   String
  bloodType     String
  unitsRequired Int
  scheduledDate DateTime
  scheduledTime String
  status        String               @default("SCHEDULED")
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  hospital      HospitalRegistration @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId])
  @@index([hospitalId, scheduledDate])
}

model HospitalRegistration {
  id                            String               @id @default(uuid())
  bloodBankLicense              String
  licenseExpiryDate             DateTime?
  sbtcNoc                       Boolean
  nocNumber                     String
  nocExpiryDate                 DateTime?
  nbtcCompliance                Boolean
  nacoCompliance                Boolean
  hospitalName                  String
  hospitalAddress               String
  city                          String
  state                         String
  pincode                       String
  operationalStatus             String
  coldStorageFacility           Boolean
  temperatureStandards          Boolean
  testingLabsOnsite             Boolean
  affiliatedLabs                String
  qualifiedMedicalOfficer       Boolean
  certifiedTechnicians          String
  contactEmail                  String
  contactPhone                  String
  inventoryReporting            Boolean
  realTimeUpdates               Boolean
  emergencyResponseCommitment   Boolean
  responseTimeMinutes           String
  dataHandlingCommitment        Boolean
  confidentialityAgreement      Boolean
  bloodBankLicenseDoc           String?
  hospitalRegistrationCert      String?
  authorizedRepIdProof          String?
  contactDetails24x7            String
  mouAcceptance                 Boolean
  repName                       String
  repDesignation                String
  repIdNumber                   String
  repEmail                      String
  repPhone                      String
  termsAccepted                 Boolean
  dataProcessingConsent         Boolean
  networkParticipationAgreement Boolean
  status                        ApprovalStatus       @default(PENDING)
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  latitude                      String?
  longitude                     String?
  lastVerificationAt            DateTime?
  suspendedUntil                DateTime?
  verificationAttempts          Int                  @default(0)
  alerts                        Alert[]
  approvals                     Approval[]           @relation("HospitalApprovals")
  inventoryThresholds           InventoryThreshold[]
  inventory                     InventoryUnit[]
  otSchedules                   OTSchedule[]
  transportsFrom                TransportRequest[]   @relation("TransportFrom")
  transportsTo                  TransportRequest[]   @relation("TransportTo")
}

model Admin {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  approvals Approval[]
}

model Approval {
  id         String                @id @default(uuid())
  approvedBy String
  approvedAt DateTime              @default(now())
  decision   Decision
  remarks    String?
  status     ApprovalStatus        @default(PENDING)
  hospitalId String?
  donorId    String?
  admin      Admin                 @relation(fields: [approvedBy], references: [id])
  donor      Donor?                @relation("DonorApprovals", fields: [donorId], references: [id])
  hospital   HospitalRegistration? @relation("HospitalApprovals", fields: [hospitalId], references: [id])
}

model Alert {
  id           String               @id @default(uuid())
  bloodType    String
  latitude     String?
  longitude    String?
  urgency      UrgencyLevel
  unitsNeeded  String
  searchRadius String
  description  String?
  hospitalId   String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  status       String               @default("PENDING")
  autoDetected Boolean              @default(false)
  type         String               @default("Blood")
  // --- Outcome capture (decision-intelligence layer) -----------------------
  /// When the alert reached a terminal state (fulfilled/partial/failed/cancelled).
  resolvedAt     DateTime?
  /// Units actually secured (donor arrivals + delivered transfers).
  unitsCollected Int       @default(0)
  /// FULFILLED | PARTIAL | ESCALATED | FAILED | CANCELLED (see lib/ml/types.ts ALERT_OUTCOMES)
  outcome        String?
  /// donors | inventory | mixed | external
  fulfilledBy    String?
  hospital     HospitalRegistration @relation(fields: [hospitalId], references: [id])
  responses    AlertResponse[]

  @@index([status])
  @@index([outcome])
}

model AlertResponse {
  id        String         @id @default(uuid())
  alertId   String
  donorId   String
  status    ResponseStatus @default(PENDING)
  createdAt DateTime       @default(now())
  alert     Alert          @relation(fields: [alertId], references: [id])
  donor     Donor          @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([alertId, donorId])
  @@index([donorId])
}

model Document {
  id        Int      @id @default(autoincrement())
  fileUrl   String
  createdAt DateTime @default(now())
}

model DonorVerification {
  id                 String             @id @default(cuid())
  donorId            String
  docType            DonorDocumentType
  docUrl             String
  status             VerificationStatus @default(PENDING)
  confidence         Float?
  extractedFields    Json?
  mismatchFields     Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  eligibilityChecked Boolean            @default(false)
  eligibilityPassed  Boolean            @default(false)
  failedCriteria     Json?
  donor              Donor              @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@index([donorId])
}

model AgentEvent {
  id        String   @id @default(uuid())
  type      String
  payload   Json
  processed Boolean  @default(false)
  agentType String?
  createdAt DateTime @default(now())

  @@index([type, processed])
  @@index([createdAt])
}

model WorkflowState {
  id              String   @id @default(uuid())
  requestId       String   @unique
  status          String
  currentStep     String
  metadata        Json
  fulfillmentPlan Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([requestId])
  @@index([status])
}

model AgentDecision {
  id         String   @id @default(uuid())
  agentType  String
  eventType  String
  eventId    String?
  requestId  String?
  decision   Json
  confidence Float?
  createdAt  DateTime @default(now())

  @@index([agentType, createdAt])
  @@index([requestId])
}

model InventoryUnit {
  id          String               @id @default(uuid())
  hospitalId  String
  bloodType   String
  units       Int
  expiryDate  DateTime
  reserved    Boolean              @default(false)
  reservedFor String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  hospital    HospitalRegistration @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId, bloodType])
  @@index([reserved])
  @@index([expiryDate])
}

model InventoryThreshold {
  id              String               @id @default(uuid())
  hospitalId      String
  bloodType       String
  minimumRequired Int
  optimalLevel    Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  hospital        HospitalRegistration @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, bloodType])
  @@index([hospitalId])
}

model TransportRequest {
  id              String               @id @default(uuid())
  fromHospitalId  String
  toHospitalId    String
  bloodType       String
  units           Int
  status          String
  eta             DateTime?
  pickupTime      DateTime?
  deliveryTime    DateTime?
  transportMethod String?
  /// Set by the scheduler once delivered/cancelled: usable units arrived in time.
  deliveredOk       Boolean?
  coldChainBreached Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  fromHospital    HospitalRegistration @relation("TransportFrom", fields: [fromHospitalId], references: [id])
  toHospital      HospitalRegistration @relation("TransportTo", fields: [toHospitalId], references: [id])

  @@index([status])
  @@index([fromHospitalId])
  @@index([toHospitalId])
}

model DonorResponseHistory {
  id              String            @id @default(uuid())
  donorId         String
  requestId       String
  notifiedAt      DateTime
  respondedAt     DateTime?
  responseTime    Int?
  status          String
  confirmed       Boolean           @default(false)
  noShow          Boolean           @default(false)
  distance        Float?
  score           Float?
  createdAt       DateTime  @default(now())
  expectedArrival DateTime?
  /// When the hospital confirmed the donor arrived (label for donor_show / donor_eta).
  arrivedAt         DateTime?
  donationCompleted Boolean   @default(false)
  donor           Donor     @relation("DonorHistory", fields: [donorId], references: [id], onDelete: Cascade)

  @@index([donorId])
  @@index([requestId])
  @@index([status])
  @@index([donorId, requestId])
}

model PilotRequest {
  id            String   @id @default(uuid())
  hospitalName  String
  contactPerson String
  email         String
  phone         String
  location      String
  hasBloodBank  Boolean
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model PilotAnalytics {
  id          String   @id @default(uuid())
  eventType   String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  referrer    String?
  userAgent   String?
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([utmMedium])
  @@index([createdAt])
  @@index([eventType, createdAt])
}

model TrainingExample {
  id              String   @id @default(uuid())
  taskType        String
  inputFeatures   Json
  outputLabel     Json
  outcome         Json?
  agentDecisionId String?
  requestId       String?
  usedForTraining Boolean  @default(false)
  /// sim | real
  source          String   @default("real")
  /// Simulator scenario id (grouped splits) or production requestId.
  scenarioId      String?
  datasetVersion  String?
  createdAt       DateTime @default(now())

  @@index([taskType, usedForTraining])
  @@index([agentDecisionId])
  @@index([requestId])
  @@index([createdAt])
  @@index([source, datasetVersion])
}

/// One row per model VERSION (e.g. "haemologix-model-1.0"). A version bundles every
/// prediction task; per-task metrics live in `metrics`. Status lifecycle:
/// training → evaluated → approved → active → retired.
model CustomModel {
  id          String            @id @default(uuid())
  version     String            @unique
  taskType    String            @default("all")
  modelPath   String
  config      Json
  metrics     Json?
  status      String            @default("training")
  isActive    Boolean           @default(false)
  trainedAt   DateTime          @default(now())
  deployedAt  DateTime?
  // --- Lineage / model card ------------------------------------------------
  datasetVersion String?
  /// {"sim": n, "real": n}
  datasetMix     Json?
  /// {"donor_accept": [...feature names], ...}
  features       Json?
  limitations    String?
  approvedBy     String?
  approvedAt     DateTime?
  notes          String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  predictions ModelPrediction[]

  @@index([taskType, isActive])
  @@index([status])
}

/// One row per prediction the model service made for a live agent step.
/// `actualOutcome` / `error` are back-filled by the scheduler once the real
/// outcome is known, which is what makes shadow-mode evaluation possible.
model ModelPrediction {
  id            String      @id @default(uuid())
  modelId       String
  taskType      String
  inputFeatures Json
  prediction    Json
  confidence    Float?
  actualOutcome Json?
  feedback      String?
  requestId     String?
  /// Which agent asked (HOSPITAL | DONOR | COORDINATOR | INVENTORY | LOGISTICS | VERIFICATION)
  agentType     String?
  /// shadow | advise | authority
  mode          String      @default("shadow")
  latencyMs     Int?
  /// Secondary key inside a request (e.g. donorId for donor_accept rows).
  subjectId     String?
  outcomeAt     DateTime?
  /// |prediction - actual| for regression / binary; set with actualOutcome.
  error         Float?
  createdAt     DateTime    @default(now())
  model         CustomModel @relation(fields: [modelId], references: [id])

  @@index([modelId])
  @@index([taskType, createdAt])
  @@index([requestId])
  @@index([requestId, taskType, subjectId])
  @@index([agentType, mode])
}

model User {
  id        String     @id @default(uuid())
  name      String?
  email     String     @unique
  clerkId   String     @unique
  password  String?
  role      UserRole   @default(DONOR)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  donations Donation[]
  feedback  Feedback[]
}

model Feedback {
  id         String   @id @default(uuid())
  userId     String
  role       UserRole
  type       String
  message    String
  screenshot String?
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Donation {
  id        String   @id @default(uuid())
  amount    Int
  status    String   @default("PENDING")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

/// A completely isolated, resettable judge sandbox. The single `global` row
/// contains only synthetic demo data and is never related to production data.
model DemoSandbox {
  id             String   @id
  schemaVersion  Int      @default(1)
  revision       Int      @default(0)
  state          Json
  expiresAt      DateTime
  lastActivityAt DateTime
  lastResetAt    DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// A user-submitted request to delete an account and its associated data,
/// raised from the public /delete-account page. Requests are recorded here
/// and processed manually after identity verification — the public endpoint
/// never deletes data directly, since it is unauthenticated.
model AccountDeletionRequest {
  id          String                @id @default(uuid())
  email       String
  phone       String?
  reason      String?
  status      DeletionRequestStatus @default(PENDING)
  notes       String?
  requestedAt DateTime              @default(now())
  processedAt DateTime?
  updatedAt   DateTime              @updatedAt

  @@index([email])
  @@index([status])
  @@index([requestedAt])
}

// ---------------------------------------------------------------------------
// Tables owned by the mobile backend (app-backend), declared here ONLY so that
// `prisma db push` from this repo leaves them alone.
//
// Prisma reconciles the whole database to whichever schema it is run from, so a
// table missing here is a table `db push` will DROP — which is exactly what
// happened the first time this migration ran. This app never reads or writes
// them; change them in app-backend/prisma/schema.prisma and mirror the result
// here.
//
// `donorId` is intentionally a plain column with no foreign key: app-backend
// must not constrain tables this app owns.
// ---------------------------------------------------------------------------

model AppRefreshToken {
  id           String    @id @default(uuid())
  donorId      String
  tokenHash    String    @unique
  deviceId     String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([donorId])
  @@index([expiresAt])
}

model AppOtpChallenge {
  id         String    @id @default(uuid())
  phoneE164  String
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  sendCount  Int       @default(1)
  consumedAt DateTime?
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([phoneE164, expiresAt])
}

model AppDeviceToken {
  id         String    @id @default(uuid())
  donorId    String
  token      String    @unique
  platform   String
  appVersion String?
  lastSeenAt DateTime  @default(now())
  disabledAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([donorId, disabledAt])
}

model AppNotification {
  id        String    @id @default(uuid())
  donorId   String
  type      String
  title     String
  body      String
  data      Json?
  alertId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([donorId, createdAt])
  @@index([donorId, readAt])
}

model AppDonorLocation {
  donorId   String   @id
  latitude  Float
  longitude Float
  accuracyM Float?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AppJobCheckpoint {
  job       String   @id
  position  DateTime
  updatedAt DateTime @updatedAt
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Decision {
  APPROVED
  REJECTED
}

enum UrgencyLevel {
  MEDIUM
  HIGH
  CRITICAL
}

enum ResponseStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum VerificationStatus {
  PENDING
  AUTO_REJECTED
  MATCHED_FOR_ADMIN
  ADMIN_REJECTED
  APPROVED
}

enum DonorDocumentType {
  BLOOD_TEST
  ID_PROOF
  MEDICAL_CERTIFICATE
}

enum AgentType {
  HOSPITAL
  DONOR
  COORDINATOR
  INVENTORY
  LOGISTICS
  COMPLIANCE
  VERIFICATION
}

enum WorkflowStatus {
  PENDING
  MATCHING
  FULFILLMENT_IN_PROGRESS
  FULFILLED
  FAILED
  CANCELLED
}

enum UserRole {
  ADMIN
  HOSPITAL
  DONOR
}

enum DeletionRequestStatus {
  PENDING
  VERIFIED
  COMPLETED
  REJECTED
}
