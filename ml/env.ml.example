# Copy to ml/.env. Loaded by:
#   - scripts/ml/loadEnv.ts   (tsx scripts: sim, harvest, register/approve/activate)
#   - scripts/ml/Use-MlEnv.ps1 (PowerShell: prisma CLI)
#   - ml/api/server.py + ml/training (python-dotenv)
#
# Dedicated ML database (never production).
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Model service
ML_API_URL=http://localhost:8000
ML_API_SECRET=change-me
ML_TIMEOUT_MS=3000
ML_MODEL_DIR=ml/checkpoints
# Leave empty to serve whatever ml/checkpoints/active points at.
ML_ACTIVE_VERSION=

# Per-agent authority: off | shadow | advise | authority
ML_MODE_DEFAULT=shadow
# ML_MODE_HOSPITAL=
# ML_MODE_DONOR=
# ML_MODE_COORDINATOR=
# ML_MODE_INVENTORY=
# ML_MODE_LOGISTICS=
# ML_MODE_VERIFICATION=

CRON_SECRET=change-me
