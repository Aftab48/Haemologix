# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL='postgresql://user:password@host/dbname?sslmode=require'

# ─── Clerk Authentication ──────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="your-s3-bucket-name"

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your_app_password"

# ─── Twilio SMS ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# ─── Maps & Geocoding ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
GOOGLE_MAPS_BASE_URL="https://maps.googleapis.com/maps/api"
GOOGLE_MAPS_DEFAULT_COUNTRY="India"
GOOGLE_MAPS_TIMEOUT="10000"
OPENCAGE_API_KEY="your_opencage_api_key"

# ─── AI / ML ──────────────────────────────────────────────────────────────────
NANONETS_API_KEY="your_nanonets_api_key"
GEMINI_API_KEY="your_gemini_api_key"

# Haemologix model service (FastAPI, see ml/README.md). The agents call this
# instead of an external LLM; when unreachable they fall back to deterministic rules.
ML_API_URL="http://localhost:8000"
ML_API_SECRET="change-me"
ML_TIMEOUT_MS="3000"
# Authority of the model per agent: off | shadow | advise | authority
ML_MODE_DEFAULT="shadow"
# ML_MODE_HOSPITAL=, ML_MODE_DONOR=, ML_MODE_COORDINATOR=, ML_MODE_INVENTORY=,
# ML_MODE_LOGISTICS=, ML_MODE_VERIFICATION= override the default per agent.
# Outcome-capture tunables (minutes / hours)
ML_NO_SHOW_GRACE_MIN="45"
ML_RESPONSE_WINDOW_MIN="60"
ML_ALERT_WINDOW_HOURS="6"

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Base URL used to build links inside outgoing emails (reset links, sign-in).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ─── Password reset ───────────────────────────────────────────────────────────
# Secret used to sign /donor/forgot-password/[id] links. Falls back to
# CLERK_SECRET_KEY when unset. Rotating it invalidates all outstanding links.
PASSWORD_RESET_SECRET="your_password_reset_signing_secret"

# ─── Admin ────────────────────────────────────────────────────────────────────
# A 4–6 digit PIN shown to admin users as a second factor on the admin page.
# Real access control is enforced server-side via Clerk roles (ADMIN_USER_IDS).
NEXT_PUBLIC_ADMIN_PASSKEY="your_admin_pin"

# Comma-separated Clerk user IDs that have admin access to protected API routes.
# Example: ADMIN_USER_IDS="user_abc123,user_xyz456"
ADMIN_USER_IDS=""

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Secret token for cron/scheduler endpoints (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="your_secure_cron_secret"

# ─── Feature flags ────────────────────────────────────────────────────────────
REALDATA_SANDBOX=1
SANDBOX_NOTIFICATIONS=1
